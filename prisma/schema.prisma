generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  imageUrl    String
  price       Int
  size        FrameSize
  color       FrameColor
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum FrameSize {
  A4
  A3
  A2
  LARGE
}

enum FrameColor {
  WALNUT
  BLACK
  WHITE
  GOLDEN
  NATURAL_OAK
  ROSEWOOD
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  total           Int
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(RECEIVED)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PaymentMethod {
  RAZORPAY
  UPI
  CARD
  NET_BANKING
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
